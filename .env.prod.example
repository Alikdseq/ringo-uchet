# Скопируйте на сервер: cp .env.prod.example .env.prod
# и заполните секреты. Файл .env.prod не коммитится в git.

# --- Домен и сервер ---
DOMAIN=ringoouchet.ru
SERVER_IP=89.169.38.5

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-long-random-string
DJANGO_SETTINGS_MODULE=ringo_backend.settings.prod
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=ringoouchet.ru,www.ringoouchet.ru,89.169.38.5,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://ringoouchet.ru,https://www.ringoouchet.ru,http://ringoouchet.ru,http://www.ringoouchet.ru,http://89.169.38.5
CORS_ALLOWED_ORIGINS=https://ringoouchet.ru,https://www.ringoouchet.ru
CORS_ALLOW_ALL_ORIGINS=true

# --- База данных ---
DB_NAME=ringo_prod
DB_USER=ringo_user
DB_PASSWORD=change-me-strong-password
POSTGRES_DB=ringo_prod
POSTGRES_USER=ringo_user
POSTGRES_PASSWORD=change-me-strong-password

# --- MinIO / S3 ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change-me-minio-password
AWS_BUCKET=ringo-media-prod
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1

# --- JWT ---
JWT_ACCESS_MINUTES=480
JWT_REFRESH_DAYS=30

# --- Frontend (опционально) ---
NEXT_PUBLIC_API_URL=/api/v1
NPM_REGISTRY=https://registry.npmjs.org
